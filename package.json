{
  "name": "bb-plugin-pins",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "Pins",
    "description": "Pin chat messages, see them in a bar at the top of the thread, and find every pin in a Pins tab of the right panel.",
    "branding": {
      "icon": "./assets/pin.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.6",
    "hono": "^4.13.22",
    "jsdom": "^27.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "description": "Telegram-style pins for BB chats.",
  "author": "yazydzhi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yazydzhi/bb-plugin-pins.git"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
